{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://playaig.com/schemas/taxonomy.schema.json","type":"object","additionalProperties":false,"required":["id","slug","name","description","verificationStatus"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},"slug":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"name":{"type":"string","minLength":1},"description":{"type":["string","null"]},"verificationStatus":{"enum":["verified","partially-verified","unverified"]}}}
