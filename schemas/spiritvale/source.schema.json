{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://playaig.com/schemas/source.schema.json","type":"object","additionalProperties":false,"required":["id","name","sourceType","url","owner","accessedAt","reliability","notes","sourceId","sourceAuthority","sourceUrl","publisher","verificationLevel","lastChecked","allowedFields"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},"name":{"type":"string","minLength":1},"sourceType":{"enum":["official","community","manual","import","api"]},"url":{"type":"string","format":"uri"},"owner":{"type":"string","minLength":1},"accessedAt":{"type":"string","format":"date-time"},"reliability":{"enum":["primary","secondary","community"]},"notes":{"type":["string","null"]},"sourceId":{"type":"string","pattern":"^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"},"sourceAuthority":{"type":"string","minLength":1},"sourceUrl":{"type":"string","format":"uri"},"publisher":{"type":"string","minLength":1},"verificationLevel":{"type":"integer","minimum":1,"maximum":3},"lastChecked":{"type":"string","format":"date-time"},"allowedFields":{"type":"array","items":{"type":"string","pattern":"^[a-z][a-zA-Z0-9]*$"},"minItems":1,"uniqueItems":true}}}
