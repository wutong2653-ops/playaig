{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playaig.com/schemas/guide.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "slug", "name", "shortDescription", "description", "status",
    "verificationStatus", "sourceIds", "gameVersionId", "imageAssetIds",
    "createdAt", "updatedAt", "lastVerifiedAt", "notes", "guideTypeId",
    "summary", "intro", "sectionIds", "sections", "faqItems",
    "relatedGuideIds", "relatedClassIds", "relatedDatabaseCategoryIds", "relatedBuildIds", "relatedSkillIds",
    "relatedEquipmentIds", "relatedCardIds", "relatedArtifactIds",
    "relatedBossIds", "relatedMonsterIds", "relatedMapIds", "editorialStatus",
    "factReviewStatus", "reviewedAt", "seo"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "shortDescription": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "status": { "enum": ["draft", "review", "published", "archived"] },
    "verificationStatus": { "enum": ["verified", "partially-verified", "unverified"] },
    "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "gameVersionId": { "type": ["string", "null"] },
    "imageAssetIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "lastVerifiedAt": { "type": ["string", "null"], "format": "date-time" },
    "notes": { "type": ["string", "null"] },
    "guideTypeId": { "type": "string" },
    "summary": { "type": ["string", "null"] },
    "intro": { "type": ["string", "null"] },
    "sectionIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "heading", "anchor", "contentBlocks", "sourceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "heading": { "type": "string", "minLength": 1 },
          "anchor": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "contentBlocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "text", "items", "imageAssetId", "caption", "sourceIds"],
              "properties": {
                "type": { "enum": ["paragraph", "list", "callout", "image", "table", "class-list"] },
                "text": { "type": ["string", "null"] },
                "items": { "type": "array", "items": { "type": "string" } },
                "imageAssetId": { "type": ["string", "null"] },
                "caption": { "type": ["string", "null"] },
                "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
              }
            }
          },
          "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "faqItems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "question", "answer", "sourceIds"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "question": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 1 },
          "sourceIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "relatedGuideIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedClassIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedDatabaseCategoryIds": { "type": "array", "items": { "enum": ["skills", "equipment", "cards", "artifacts", "monsters", "bosses", "maps"] }, "uniqueItems": true },
    "relatedBuildIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedSkillIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedEquipmentIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedCardIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedArtifactIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedBossIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedMonsterIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "relatedMapIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "editorialStatus": { "enum": ["draft", "reviewed", "published"] },
    "factReviewStatus": { "enum": ["unverified", "partially-verified", "verified"] },
    "reviewedAt": { "type": ["string", "null"], "format": "date-time" },
    "seo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description", "canonicalPath", "index"],
      "properties": {
        "title": { "type": ["string", "null"] },
        "description": { "type": ["string", "null"] },
        "canonicalPath": { "type": "string", "pattern": "^/[-a-z0-9/]+/$" },
        "index": { "type": "boolean" }
      }
    }
  }
}
